# Application
# NENE2_NODE_APP_ENV=local
# NENE2_NODE_APP_DEBUG=true
# NENE2_NODE_SERVICE_NAME=NENE2
# NENE2_NODE_REQUEST_MAX_BODY_BYTES=1048576
# PROBLEM_DETAILS_BASE_URL=https://nene2.dev/problems/

# Optional: path to NENE2 OpenAPI contract (default: ../NENE2/docs/openapi/openapi.yaml)
# NENE2_NODE_OPENAPI_PATH=../NENE2/docs/openapi/openapi.yaml

# Optional: dev server port (serve script — Phase 1+)
# NENE2_NODE_PORT=3000

# Machine client (protects GET /machine/health)
# NENE2_MACHINE_API_KEY=

# Optional: database URL for adapters (Phase 4+)
# NENE2_NODE_DATABASE_URL=file:./var/dev.sqlite

# Do not commit real secrets.
