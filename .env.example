# Application
# NENE2_NODE_APP_ENV=local
# NENE2_NODE_APP_DEBUG=true
# NENE2_NODE_SERVICE_NAME=NENE2
# NENE2_NODE_REQUEST_MAX_BODY_BYTES=1048576
# PROBLEM_DETAILS_BASE_URL=https://nene2.dev/problems/

# Optional: path to NENE2 OpenAPI contract (requires NENE2 sibling clone; CI uses pinned fixtures)
# NENE2_NODE_OPENAPI_PATH=../NENE2/docs/openapi/openapi.yaml

# Dev server port (npm run dev)
# NENE2_NODE_PORT=3000

# Machine client (protects GET /machine/health)
# NENE2_MACHINE_API_KEY=

# Database: SQLite file, MySQL, or PostgreSQL — enables adapters + example schema + DB health
# NENE2_NODE_DATABASE_URL=file:./var/dev.sqlite

# Optional read replica (MySQL)
# NENE2_NODE_DATABASE_READ_URL=

# Example routes (/examples/*) — default false in production
# NENE2_NODE_INCLUDE_EXAMPLES=true

# Bearer JWT for /examples/protected, /examples/notes, /examples/tags (when examples enabled)
# NENE2_LOCAL_JWT_SECRET=

# Do not commit real secrets.
